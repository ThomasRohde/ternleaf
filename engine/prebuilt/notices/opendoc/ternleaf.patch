+/// The Word compatibility layout for a single varied-fill column series with
+/// hidden axes and a right overlay legend. Four Word drawing extents agree on
+/// the 11 pt plot inset and the 17.6 pt legend pitch for this combination.
+fn word_overlay_columns(chart: &Chart) -> bool {
+    let [group] = chart.plot_area.groups.as_slice() else {
+        return false;
+    };
+    chart.title.is_none()
+        && chart.font.is_none()
+        && chart.legend.as_ref().is_some_and(|legend| {
+            legend.overlay && legend.position == LegendPosition::Right && legend.font.is_none()
+        })
+        && matches!(
+            group.kind,
+            ChartGroupKind::Bar {
+                direction: BarDirection::Column,
+                grouping: BarGrouping::Clustered,
+                ..
+            }
+        )
+        && varied_columns(group)
+        && chart.plot_area.axes.len() == 2
+        && chart.plot_area.axes.iter().all(|axis| {
+            axis.deleted
+                && axis.minimum.is_none()
+                && axis.maximum.is_none()
+                && axis.orientation != AxisOrientation::MaxMin
+        })
+}
+
+fn varied_columns(group: &ChartGroup) -> bool {
