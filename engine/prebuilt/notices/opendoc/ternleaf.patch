+/// A Word text version retained with its owning paragraph. A change to the
+/// projected text produces a different token; an exact undo restores the token
+/// from the source, without changing or allocating history operations.
+#[derive(Clone, Copy, Debug, serde::Deserialize, Eq, PartialEq, serde::Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct WordTextVersion {
+    /// The imported Word token.
+    pub id: u32,
+    fingerprint: [u32; 2],
+}
+
+impl WordTextVersion {
+    /// Capture the text projection corresponding to an imported token.
+    pub fn imported(id: u32, inlines: &[InlineNode]) -> Self {
+        Self {
+            id,
+            fingerprint: word_text_fingerprint(inlines),
+        }
+    }
+
+    /// Return the original token for unchanged text, or a new version token.
+    pub fn for_export(self, inlines: &[InlineNode]) -> u32 {
+        let fingerprint = word_text_fingerprint(inlines);
+        if fingerprint == self.fingerprint {
+            return self.id;
+        }
+        let candidate = (fingerprint[0] ^ fingerprint[1]) & 0x7fff_ffff;
+        let candidate = candidate.max(1);
+        if candidate == self.id {
+            candidate % 0x7fff_ffff + 1
+        } else {
+            candidate
+        }
+    }
+}
+
+fn word_text_fingerprint(inlines: &[InlineNode]) -> [u32; 2] {
+    // FNV-1a is deterministic across browser/native exports. Two u32s keep
+    // serde's JSON representation lossless when a paragraph enters history.
+    let hash = node_plain_text(inlines)
+        .bytes()
+        .fold(0xcbf2_9ce4_8422_2325u64, |hash, byte| {
+            (hash ^ u64::from(byte)).wrapping_mul(0x0100_0000_01b3)
+        });
+    [hash as u32, (hash >> 32) as u32]
+}
