+        .enumerate()
+        .filter_map(|(index, name)| {
+            shape_colored(&name, &text, shape).map(|label| (label, paint.point(index)))
+        })
+        .collect();
+    let Some(label_width) = entries.iter().map(|(label, _)| label.width).max() else {
+        return;
+    };
+    let key = Twip(105);
+    let label_gap = Twip(47);
+    let x = full.right() - Twip(200) - label_width - key - label_gap;
+    let mut baseline =
+        full.origin.y + Twip((full.size.height.raw() - 352 * (entries.len() as i32 - 1)) / 2 + 64);
+    for (label, color) in entries {
+        out.push(ChartPrimitive::Rect {
+            rect: Rect::new(Point::new(x, baseline - Twip(117)), Size::new(key, key)),
+            fill: Some(color),
+            stroke: None,
+        });
+        place_label(&label, x + key + label_gap, baseline, out);
+        baseline = baseline + Twip(352);
+    }
+}
