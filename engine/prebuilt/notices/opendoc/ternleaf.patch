+fn draw_word_column_grid(chart: &Chart, plot: Rect, scale: Scale, out: &mut Vec<ChartPrimitive>) {
+    if !chart
+        .plot_area
+        .axes
+        .iter()
+        .any(|axis| axis.kind == AxisKind::Value && axis.major_gridlines)
+    {
+        return;
+    }
+    let stroke = ChartStroke::solid([0, 0, 0, 255], Twip(15));
+    for tick in scale.ticks() {
+        let y = along(plot.bottom(), plot.origin.y, scale.fraction(tick));
+        out.push(ChartPrimitive::Line {
+            from: Point::new(plot.origin.x, y),
+            to: Point::new(plot.right(), y),
+            stroke,
+        });
+    }
+}
