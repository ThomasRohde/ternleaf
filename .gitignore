# Dependencies
node_modules/

# Build output and local tools
.build/
dist/
target/

# Ternleaf project files: one SQLite journal per document, and local settings
.ternleaf/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal

# Local working material that is not part of the project
.archive/

# Test output
coverage/
test-results/
playwright-report/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Word lock files and exports made while testing
~$*
*-edited.docx

# Logs and temporary files
*.log
npm-debug.log*
*.tmp
tmp/

# Secrets
.env
.env.*
!.env.example

# Editors and operating systems
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
